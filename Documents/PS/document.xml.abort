<tbody><tr id="_7e284e7e-366b-a8c8-0372-07235a239568"><td id="_2d91752a-8579-4a71-d4be-c972157324ba" valign="top" align="left">Class</td>
<td id="_3f7d8bd3-b2c0-8026-bd8a-907c9047fdac" valign="top" align="left">S100_ProductSpecification</td>
<td id="_4ed55fb3-1f6b-b91c-00f8-fdffb97adf7b" valign="top" align="left">The Product Specification contains the information needed to build the specified product</td>
<td id="_be6cd122-28e7-8568-168d-4912e7b28e9f" valign="top" align="left">-</td>
<td id="_b4c39034-afae-13fc-f6be-9197551c4b9b" valign="top" align="left">-</td>
<td id="_e29cc27f-3cdf-a2bb-38e9-af207e2aa247" valign="top" align="left"/></tr><tr id="_9de6634f-ca6b-200e-17a7-bd0b0b103033"><td id="_87f94f41-e8e0-c8a9-087c-99fcbafed1e2" valign="top" align="left">Attribute</td>
<td id="_a6f5fdb4-fd37-44b6-caf2-72972337f613" valign="top" align="left">name</td>
<td id="_3e4d2e9b-0765-5808-4553-689ca77dc431" valign="top" align="left">The name of the Product Specification used to create the datasets</td>
<td id="_daab47ea-10e5-de3d-53e9-9b0981f5dd18" valign="top" align="left"><strong>1</strong></td>
<td id="_12de4ba1-af99-274a-707b-57471deaa5ce" valign="top" align="left">CharacterString</td>
<td id="_85967e97-85de-9dcd-5a43-b964df97ea68" valign="top" align="left">“Marine Radio Services” (without quotes)</td>
</tr><tr id="_89517de0-30b6-66cf-b85a-b1610961731f"><td id="_4bba09c8-65a9-b1f0-4fb5-f545187f0f78" valign="top" align="left">Attribute</td>
