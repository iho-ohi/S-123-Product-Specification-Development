<th id="_d002ced0-b523-c9c4-1534-991b641e4e5c" valign="top" align="left">Type</th>
<th id="_71e8b28d-fc03-78f4-f36f-fbd0b1a89e38" valign="top" align="left">Remarks</th>
</tr><tr id="_587492fa-ab3a-7bf4-e4c4-fec653cbed27"><td id="_a4f0f1e8-221f-34f6-f040-1f9486143e67" valign="top" align="left">Class</td>
<td id="_4a009096-490b-8fb6-900c-18662559822b" valign="top" align="left">PT_Locale</td>
<td id="_d5695333-7606-dc55-127e-1a418d600596" valign="top" align="left">description of a locale</td>
<td id="_63e6aaee-5ed9-d297-8389-e8d4a2508cc1" valign="top" align="left">-</td>
<td id="_c25cc2d7-9880-d12a-135b-b38be9c2c235" valign="top" align="left">-</td>
<td id="_92fec72c-baee-ce6d-af83-c89ede3e9f50" valign="top" align="left">From ISO 19115-1</td>
</tr><tr id="_1dba0d58-5b58-0c38-dcb3-d076de9cad3c"><td id="_78d1e8e9-d9fa-9cd7-a347-8be661f53664" valign="top" align="left">Attribute</td>
<td id="_a04d48b5-a7d5-7c3e-c7c8-8f6f5d7b0b94" valign="top" align="left">language</td>
<td id="_a69a703c-9201-fac9-4f40-1ea85bbfbe16" valign="top" align="left">designation of the locale language</td>
<td id="_5bda6597-4176-ba7f-44ef-00521a8d8f46" valign="top" align="left">1</td>
<td id="_47a9374c-c233-6405-9098-d9bb0e6010cd" valign="top" align="left">LanguageCode</td>
<td id="_bca3e924-8825-cfe8-2086-6ab5b4fc025b" valign="top" align="left">ISO 639-2/T 3-letter language codes.</td>
</tr><tr id="_9e8dd585-e4ae-1a6a-2f56-ae257b5bb115"><td id="_4c218600-b3ae-dc74-1b72-58841cfead16" valign="top" align="left">Attribute</td>
<td id="_6d209868-1d52-31b4-516e-b62b180a697f" valign="top" align="left">country</td>
<td id="_b95a63c9-082b-6301-9142-ccab0d75342b" valign="top" align="left">designation of the specific country of the locale language</td>
<td id="_f890cb8b-3220-cbda-7bcc-2503bcbf1042" valign="top" align="left">0..1</td>
<td id="_9c80b257-fb26-5863-6524-a46c8d713ae0" valign="top" align="left">CountryCode</td>
<td id="_b82d8919-48f4-dca1-f3d1-12047f9b639d" valign="top" align="left">ISO 3166-1 2-letter country codes</td>
</tr><tr id="_958fa9a4-7f20-1bbe-5326-29e835f0cd55"><td id="_8f54e0b8-b072-c7c0-5c5e-59dfaba8e6b2" valign="top" align="left">Attribute</td>
<td id="_c8095779-d2e5-2d4d-2329-be488e217c7b" valign="top" align="left">characterEncoding</td>
<td id="_2dbddade-8d6c-41b3-e565-5aa37609e06b" valign="top" align="left">designation of the character set to be used to encode the textual value of the locale</td>
<td id="_d7f58f5f-28c3-4824-1548-1b9a4fd3f792" valign="top" align="left">1</td>
<td id="_d7c4cc60-f9fc-c36e-d97e-ef401d6da737" valign="top" align="left">MD_CharacterSetCode</td>
<td id="_a5e947e2-1215-5598-497b-ed0a5be7e70b" valign="top" align="left">UTF-8 is used in S-100</td>
</tr></tbody>
</table>
</clause>

<clause id="_4f4fe144-a604-6609-6bf3-547290ba84a0" anchor="sec_10.2.6.4" obligation="normative">
<title id="_106627cd-6f79-261e-25f3-f600993886f5">EX_GeographicBoundingBox</title>
<p id="_ef2d8a78-bc9a-1108-ba5d-9b181c3403cf">From ISO 19115-1.</p>

<table id="_1f64c074-6504-332b-4b10-4a5ecf3a2280" unnumbered="true"><colgroup><col width="10%"/><col width="19%"/><col width="27%"/><col width="7%"/><col width="6%"/><col width="31%"/></colgroup><thead><tr id="_2923eff7-2a42-9925-0c1a-1865463d579b"><th id="_db6a7700-7637-14ec-e76a-95128ba7712e" valign="top" align="left">Role Name</th>
<th id="_8f2618ca-55be-4394-94d3-582b813e0b6c" valign="top" align="left">Name</th>
<th id="_b89c4a58-0c1c-7e24-7825-d14ec6b92e96" valign="top" align="left">Description</th>
<th id="_cdbcb8ac-5571-92ff-746a-6d9016a68534" valign="top" align="left">Mult</th>
