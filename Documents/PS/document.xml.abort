<td id="_a71d767f-6b55-48c4-0434-57882af8e783" valign="top" align="left"/></tr><tr id="_fd9cf938-427d-dd5d-e805-7e6091ff343b"><td id="_33edb41f-8423-fc52-ec30-c2d17b4b9349" valign="top" align="left">Attribute</td>
<td id="_bfdd7683-a414-f48f-97c8-5d0b86d59cc3" valign="top" align="left">digitalSignatureValue</td>
<td id="_0afede1a-c65b-0cd9-4672-31e2207a2673" valign="top" align="left">Value derived from the digital signature</td>
<td id="_a8e139f0-7bbe-12f3-b98f-e748b9dc4f5a" valign="top" align="left">1..*</td>
<td id="_2c56b70b-e0f2-a34a-8a81-6bd8c135adf4" valign="top" align="left">S100_SE_DigitalSignature(see <eref type="inline" bibitemid="IHO_S_100" citeas="S-100"><localityStack><locality type="part"><referenceFrom>15</referenceFrom></locality></localityStack></eref>)</td>
<td id="_3e8af112-a820-2032-1b5e-4781055c7328" valign="top" align="left">The value resulting from application of <em>digitalSignatureReference</em> Implemented as the digital signature format specified in <eref type="inline" bibitemid="IHO_S_100" citeas="S-100"><localityStack><locality type="part"><referenceFrom>15</referenceFrom></locality></localityStack></eref></td>
</tr><tr id="_dce2f392-713b-a4c3-fd61-0168763b1b55"><td id="_db2ffebc-4425-0d4f-96e6-548ae879d92d" valign="top" align="left">Attribute</td>
<td id="_00a00013-f357-c2f4-b8d0-f3c1d6fef406" valign="top" align="left">compressionFlag</td>
<td id="_e9e6e554-f80c-3786-59fc-4b87b15249bb" valign="top" align="left">Indicates if the resource is compressed</td>
<td id="_c6b31e33-4304-c74b-dbc3-19eb8301f11c" valign="top" align="left">1</td>
<td id="_0d3426ba-6c53-ffbc-bea6-e2a5eb251623" valign="top" align="left">Boolean</td>
<td id="_1806f93e-1e8c-f6f3-e396-5876e77b10fb" valign="top" align="left"><em>True</em> indicates a compressed resource<br/> <em>False</em> indicates an uncompressed resource</td>
</tr><tr id="_a91fb6d3-b8e7-247a-e2d8-45c64c78b820"><td id="_677ecdcd-b819-0cdd-1bf3-870fea8dbec1" valign="top" align="left">Attribute</td>
<td id="_af29d895-e25f-fb05-b6aa-70961c5f6d07" valign="top" align="left">defaultLocale</td>
<td id="_8634549c-c8b5-eac8-63f4-29133b2d00f0" valign="top" align="left">Default language and character set used in the Catalogue</td>
<td id="_e9733a6e-0c94-2bc4-f3c2-3a6476208f29" valign="top" align="left">0..1</td>
<td id="_2ee1f820-4d2d-db14-0def-a8d4efd3348e" valign="top" align="left">PT_Locale</td>
<td id="_f7dedf59-4f8b-f947-f420-cda51d629ce4" valign="top" align="left">In absence of <em>defaultLocale</em> the language is English in UTF-8</td>
</tr><tr id="_73b425f0-f408-9719-13cf-b8a55015d091"><td id="_ba2dd57d-4095-79e9-ddff-7e7822cde679" valign="top" align="left">Attribute</td>
<td id="_41ef2ec7-313d-1c81-9b39-37e70e78419a" valign="top" align="left">otherLocale</td>
<td id="_2843b640-111b-22fa-dc04-06939f664587" valign="top" align="left">Other languages and character sets used in the Catalogue</td>
<td id="_7ba089da-4ebf-6b4f-eb71-af74906c2d08" valign="top" align="left">0..*</td>
<td id="_bf2ee4bf-fb7a-914b-ab53-0c84f7902475" valign="top" align="left">PT_Locale</td>
<td id="_3715f896-2016-c9a6-53a5-ce1e84e3fb34" valign="top" align="left"/></tr></tbody>
</table>

