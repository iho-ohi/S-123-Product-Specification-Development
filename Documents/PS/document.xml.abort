<bibitem id="_fabbfd3c-7e32-4615-cf36-3fb6f832a6a0" type="standard" schema-version="v1.5.6" anchor="ISO_19115_3_2023">
  <fetched>2026-06-30</fetched>
  
<title language="en" script="Latn" type="title-intro">Geographic information</title>

  
