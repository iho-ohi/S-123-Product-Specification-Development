<bibitem id="_10143c95-cd35-1ee6-352f-6372c67086f9" type="standard" schema-version="v1.5.6" anchor="ISO_19115_1_2014">
  <fetched>2026-06-30</fetched>
  
<title language="en" script="Latn" type="title-intro">Geographic information</title>

  
