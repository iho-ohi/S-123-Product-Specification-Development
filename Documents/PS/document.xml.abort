</tr><tr id="_411a3e21-af19-c9b3-5eed-ccf0cc0cf313"><td id="_1a80e820-977a-079d-b26f-c1d9fa27a566" valign="top" align="left">Attribute</td>
<td id="_1fcd6591-1306-bda7-17ee-0c49eef90bea" valign="top" align="left">eastBoundLongitude</td>
