<title language="fr" script="Latn" type="main">Information géographique — Métadonnées — Partie 3: Mise en oeuvre par des schémas XML</title>

  <uri type="src">https://www.iso.org/standard/80874.html</uri>
  <uri type="obp">https://www.iso.org/obp/ui/en/#!iso:std:80874:en</uri>
  <uri type="rss">https://www.iso.org/contents/data/standard/08/08/80874.detail.rss</uri>
