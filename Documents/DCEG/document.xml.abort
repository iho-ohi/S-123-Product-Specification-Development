<td id="_7d467790-60a6-dc8b-548b-afe3f8442f9a" valign="top" align="left"/><td id="_e10a4805-c616-202c-479c-e140e78ab3e8" valign="top" align="left"/><td id="_7208553a-8930-398b-003c-41ffd88758b3" valign="top" align="left"/><td id="_056b8d77-b5c3-b351-d070-8ecab78eba7a" valign="top" align="left"/><td id="_fd0ab1fa-825b-7774-0337-00926827138f" valign="top" align="left"/><td id="_83b20658-35f4-3219-eb0d-ed4f12e85a0a" valign="top" align="left"/></tr><tr id="_8cd9917d-eb70-3d5f-6da2-1f673cefdea7"><td id="_e0d2ec58-8f89-d76c-2af6-17674401775a" valign="top" align="left"><em>Real World</em></td>
<td id="_a711c0fc-dc1e-73fd-effa-8b79c1f4dbd1" valign="top" align="left"/><td id="_f244ddea-aad2-d5ad-ebce-73e80af2fb0b" valign="top" align="left"><em>Paper Chart Symbol</em></td>
<td id="_ad3c9319-9db4-58b7-4326-902b37a033b7" valign="top" align="left"/><td id="_93f4a3e0-8685-95f6-1ffc-96e93effe12d" valign="top" align="left"><em>ECDIS Symbol</em></td>
<td id="_148b7d7c-ecd9-6dbc-3215-a962c4b9023c" valign="top" align="left"/><td id="_4b61d2c3-8f66-b879-1481-4d7cc270fdf9" valign="top" align="left"/></tr><tr id="_9f5b9f0b-5e8b-527b-47c4-9edac926ae5a"><td id="_d0cdd3f7-0e47-a692-0bfc-fd5792b76f21" valign="top" align="left"><strong>S-123 Attribute</strong></td>
