</tr><tr id="_b3e65ebe-f0b6-beff-b16f-e1df431667b0"><td id="_c3563fdf-005f-9048-c1df-38269db5b27d" valign="top" align="left">This section lists the allowable <strong>local</strong> attributes for the S-123 feature or information type.</td>
<td id="_c071fba3-8522-4cb4-4c82-d6b345fe43de" valign="top" align="left"/><td id="_a71c30a7-337a-4723-b65d-4f66055c9d18" valign="top" align="left"/><td id="_9043627c-b22d-7f98-e616-593ed39956b2" valign="top" align="left"/><td id="_26c7811c-3ff6-6deb-bcb7-d874c27e6d2f" valign="top" align="left"/><td id="_e846fe46-7d90-2adb-5e2f-20b88d81fe0b" valign="top" align="left"/><td id="_4849bf2b-164a-2ddc-8c49-e439474e45e7" valign="top" align="left"/><td id="_9e30b4f2-7140-d5c7-d6b3-63dcfbf1edcc" valign="top" align="left"/><td id="_a58791b3-9072-912b-3a64-caf12097e3b7" valign="top" align="left"/><td id="_ff5dcf4c-926b-a25a-f929-d7fdb275c213" valign="top" align="left"/></tr><tr id="_9f559603-e832-c6b5-d676-fa24af5d2e25"><td id="_8c5abbe7-c5c1-681e-9718-1ee6bbc03df5" valign="top" align="left"/><td id="_c670de51-eb17-3e7f-2b06-75cf0aabb98e" valign="top" align="left"/><td id="_0c8140d9-39d7-4693-64be-f48136efcdca" valign="top" align="left"/><td id="_d9847ac5-77e9-48b5-39b2-4daed37904f1" valign="top" align="left"/><td id="_f020787f-8643-1d56-96bf-b80f30fbadc0" valign="top" align="left"/><td id="_7b1223e0-4ff0-872d-d5d6-8f10f9b70d4e" valign="top" align="left"/><td id="_3503848f-d300-79d5-7960-27ee03574b28" valign="top" align="left"/><td id="_42c9c961-45b5-fabd-e214-909e88317b1e" valign="top" align="left"/><td id="_4b564bc1-b8d5-c406-28bc-7c0abca02505" valign="top" align="left"/><td id="_149afd9f-18b8-3fb0-5f63-33619aa00d44" valign="top" align="left"/></tr><tr id="_989af02c-efd5-e8d1-1988-8e09e8f15aa9"><td id="_d6f84612-6f09-3620-ef5b-1e8d3f9fae2e" valign="top" align="left"><underline><strong>Feature/information associations</strong> (allowable <strong>local</strong> associations)</underline></td>
