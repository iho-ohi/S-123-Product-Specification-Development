<td id="_2bd6a73c-10d0-23c6-b667-85380b0a39b1" valign="top" align="left"><em>Paper Chart Symbol</em></td>
<td id="_2ac7bc04-0204-4bde-c502-dd6ee26e3256" valign="top" align="left"/><td id="_20dcb53d-dd17-82be-bea6-5528f60587b4" valign="top" align="left"><em>ECDIS Symbol</em></td>
<td id="_d82b1e86-f140-d461-4f42-c1d8d4df2245" valign="top" align="left"/><td id="_a637a601-d3aa-021c-690a-dd0d022f2fe3" valign="top" align="left"/></tr><tr id="_5cdf53c8-212b-0c59-3234-ad8a2ba2d337"><td id="_e59b0ce5-d221-cc7f-de63-dd830de56950" valign="top" align="left"><strong>S-123 Attribute</strong></td>
<td id="_226c014a-e682-9d77-045b-577abe8bc6f1" valign="top" align="left"><strong>S-57 Acronym</strong></td>
