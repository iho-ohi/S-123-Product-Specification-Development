<clause id="_3cd1e4c2-16c2-ea4c-26b2-311d9ab0d2eb" anchor="sec_5.10" obligation="normative">
<title id="_991c440d-f6c6-a61b-ca92-1cffd627a671">Weather Forecast and Warning Area</title>
<table id="_7aa120a0-985f-0e16-a1e5-76b76e38dc87" width="100%"><colgroup><col width="31%"/><col width="6%"/><col width="17%"/><col width="13%"/><col width="14%"/><col width="7%"/><col width="12%"/></colgroup><tbody><tr id="_05cb0406-5523-7472-5f58-d0bea1d4ab7b"><td id="_e37e42b1-fd99-c35a-ea76-73e30055500a" valign="top" align="left"><underline>IHO Definition:</underline> An area for which weather forecasts and warnings are provided for specified periods.</td>
