<td id="_f80d941a-163f-eb0c-bdf3-ea2c2bceabb8" valign="top" align="left"/><td id="_4f6c92c0-1ce2-de1f-41c5-eb8e7438af6e" valign="top" align="left"/></tr><tr id="_a5bc61eb-be49-9a89-ba72-1a0d68b96ed3"><td id="_5f0345b2-c990-c9ea-adf7-f483d5b82ca2" valign="top" align="left"><strong>S-123 Attribute</strong></td>
<td id="_c6faf18e-046f-70a8-17c0-6a235bb048a6" valign="top" align="left"/><td id="_b1e824a9-d5db-806d-6e84-cdd2f646f1cc" valign="top" align="left"><strong>S-57 Acronym</strong></td>
<td id="_2fc153f6-fe5a-f6de-a2db-9e4991cc5ea3" valign="top" align="left"><strong>Allowable Encoding Value</strong></td>
<td id="_23912086-f310-2e7d-9088-438362118944" valign="top" align="left"/><td id="_bc3dd38d-901e-affe-6630-649e6e7bb029" valign="top" align="left"><strong>Type</strong></td>
