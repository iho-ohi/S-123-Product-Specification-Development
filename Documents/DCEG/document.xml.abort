<td id="_cd81e7eb-7871-835b-6f27-a46cc9bd7029" valign="top" align="left"/><td id="_ab108c23-a630-d699-979c-c527345d053b" valign="top" align="left"/><td id="_ae0a259d-a04e-ee79-b9f6-1b1ea12d0c8f" valign="top" align="left"/><td id="_d403ac7b-dce0-88f3-6b0d-f2bd511f8ade" valign="top" align="left"/><td id="_7c3ad8eb-5b57-b17c-feb8-d279f60ba7e8" valign="top" align="left"><p id="_7f5cb1d9-d12b-2f68-5872-51e99fdcf0a9">1: prohibited</p>

<p id="_209f8bc3-525f-78a9-0562-b3c6f2b443a4">2: not recommended</p>

<p id="_2de271f7-6693-dc5c-d4d9-d3a8c75b64f1">3: permitted</p>

<p id="_6258231f-73c0-6229-175b-362068ea9145">4: recommended</p>

<p id="_7a9ac134-1145-a163-422b-1380f6dcde28">5: required</p>

<p id="_4ab3e912-d169-f6de-1188-7dc24d4afb10">6: not required</p>
</td>
<td id="_06a60f36-60fc-34c4-5cb4-14ef474f9ee1" valign="top" align="left"/><td id="_37233726-cc12-1e83-7571-81aa458621f3" valign="top" align="left">EN</td>
<td id="_6030c5ca-ecec-16e8-bf57-31bf1a0360a4" valign="top" align="left"/><td id="_a471da1c-bd0e-2e29-d0e2-062994fab3b1" valign="top" align="left">0,1</td>
</tr><tr id="_15d76016-dbd5-cc23-5b0b-27b7fa2eb012"><td id="_bb88a2da-02b8-e607-8d14-53e4eed71dd9" valign="top" align="left"><p id="_52e42714-fca3-3a0c-2574-b52194efcbcd"><underline>INT 1 Reference:</underline></p>

<p id="_6d2db889-f5c7-b05e-e536-cc2005da020a"><underline>Remarks:</underline></p>

<p id="_770d4d82-21d3-44c8-d09f-24a75f5e3453">The GML format implements and uses association classes in accordance with ISO 19136-2. The association class is implemented as an information type instance with information associations to and from the two classes linked by the association, as listed above. A generic inverse association must be used if it is necessary to encode a reverse link to a feature instance.</p>

<p id="_48ce7938-fd6a-47b4-6354-ae6dd896f7d2"><underline>Distinction:</underline></p>
</td>
<td id="_603a6234-9dcd-3afe-05d9-cd19c5c0ffdc" valign="top" align="left"/><td id="_325c8f95-b50d-4691-2ee3-82d3fbb41fa5" valign="top" align="left"/><td id="_6df9b5ac-9d31-a7fb-ba77-aa3d2c5d0a09" valign="top" align="left"/><td id="_c8177f70-a876-2ac5-5f4e-6a64116d3505" valign="top" align="left"/><td id="_114fb9ed-7612-dbbb-8172-79f611fd2b0c" valign="top" align="left"/><td id="_c256ae50-2506-0de6-5e47-5c940294980a" valign="top" align="left"/><td id="_cf71caf3-6fe3-5dec-7e5a-39b65140db93" valign="top" align="left"/><td id="_b1d216d8-33b8-0cb2-cee6-68982fd76324" valign="top" align="left"/><td id="_01d6ea5f-553f-43b1-5d73-3e9b2e299d5f" valign="top" align="left"/></tr><tr id="_c5f77941-2559-c677-5217-b0dc032bbda0"><td id="_037ab51f-90ec-f14e-c227-f5e8626a8208" valign="top" align="left"><strong>Role Type</strong></td>
<td id="_a520a95f-b9da-0601-1b7a-8c9765385b22" valign="top" align="left"><strong>Role</strong></td>
<td id="_7addf510-9ab9-5643-35cd-38ffc38ac764" valign="top" align="left"/><td id="_088f259a-a17f-4d3b-3a46-6e6f37f2b1bf" valign="top" align="left"/><td id="_24bfab0c-bdb0-505c-59f5-38fb2b5b1dd2" valign="top" align="left"><strong>Associated With</strong></td>
<td id="_e444b4b2-6bc9-2a47-454d-e7bb7d971e6b" valign="top" align="left"/><td id="_5c94ac71-4854-da77-22b4-28d941930aa2" valign="top" align="left"/><td id="_06867191-877f-bebd-7b20-d4c98416fbc5" valign="top" align="left"/><td id="_4ee5579e-412c-9612-8421-377d681caf82" valign="top" align="left"><strong>Multiplicity</strong></td>
<td id="_213fcff4-9471-2160-55ef-8c05a245461f" valign="top" align="left"/></tr><tr id="_835beeba-5f70-88dc-0e67-0f64af857796"><td id="_cb7ae9dd-93c4-8420-6cfe-d689ebe4985e" valign="top" align="left">association</td>
<td id="_cb9f6dc9-e818-8827-9509-8bc587d7b216" valign="top" align="left">Permission</td>
<td id="_18850139-70d0-a125-34d0-0984d039b4bc" valign="top" align="left"/><td id="_68d45961-8636-d22a-9711-878a02e61331" valign="top" align="left"/><td id="_b7eaf1ff-0f7e-ddb4-9c76-bdc51f7e31ab" valign="top" align="left"><strong>Applicability</strong></td>
<td id="_c54dfd10-e173-9241-da28-97468705d239" valign="top" align="left"/><td id="_83a19074-3df3-db83-b5e6-ee9301135830" valign="top" align="left"/><td id="_be34b834-0c9f-c3a5-09be-3f8175479cd2" valign="top" align="left"/><td id="_c74e79b0-d34b-2e0d-ace9-87e86b9f1a4f" valign="top" align="left">1, 1</td>
<td id="_b1bac7f0-257a-07e2-e8d4-e4315928769e" valign="top" align="left"/></tr></tbody>
