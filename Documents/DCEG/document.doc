table.MsoISOTable, table.MsoISOTableBig {
  mso-style-name: "Table ISO";
  mso-tstyle-rowband-size: 0;
  mso-tstyle-colband-size: 0;
  mso-style-noshow: yes;
  mso-style-priority: 99;
  mso-style-parent: "";
  mso-padding-alt: 0cm 2.85pt 0cm 2.85pt;
  mso-para-margin: 0cm;
  mso-para-margin-bottom: 0.0001pt;
  mso-pagination: widow-orphan;
  border-collapse: collapse;
  mso-table-layout-alt: fixed;
  border: solid windowtext 2pt;
  mso-border-alt: solid windowtext 2pt;
  mso-yfti-tbllook: 480;
  mso-border-insideh: 0.75pt solid windowtext;
  mso-border-insidev: 0.75pt solid windowtext;
  font-size: 12.0pt;
  font-family: Arial,sans-serif;
}

table.MsoISOTable th, table.MsoISOTableBig th {
  border: solid windowtext 1pt;
  mso-border-alt: solid windowtext 1pt;
  padding: 0cm 2.85pt 0cm 2.85pt;
}

table.MsoISOTable td, table.MsoISOTableBig td {
  border: solid windowtext 1pt;
  mso-border-alt: solid windowtext 1pt;
  padding: 0cm 2.85pt 0cm 2.85pt;
}

table.MsoNormalTable th, table.MsoNormalTable td {
  border: none;
  mso-border-alt: none;
}

table.MsoISOTable p, table.MsoISOTableBig p {
  font-size: 12.0pt;
}

table.MsoTableGrid {
  mso-style-name: "Table Grid";
  mso-tstyle-rowband-size: 0;
  mso-tstyle-colband-size: 0;
  mso-style-priority: 39;
  mso-style-unhide: no;
  border: solid windowtext 1pt;
  mso-border-alt: solid windowtext 0.5pt;
  mso-padding-alt: 0cm 5.4pt 0cm 5.4pt;
  mso-border-insideh: 0.5pt solid windowtext;
  mso-border-insidev: 0.5pt solid windowtext;
  mso-para-margin: 0cm;
  mso-para-margin-bottom: 0.0001pt;
  mso-pagination: widow-orphan;
  font-size: 12.0pt;
  font-family: Arial,sans-serif;
}

div.formula {
  tab-stops: right 487.45pt;
}

body {
  tab-interval: 36pt;
}

.coverpage_docnumber {
  text-align: center;
  font-size: 14pt;
  font-weight: bold;
}

.coverpage_techcommittee {
  text-align: center;
  font-size: 12.0pt;
}

.coverpage_docstage {
  text-align: center;
  font-size: 30pt;
  color: #05164d;
}

div.coverpage_warning {
  mso-element: para-border-div;
  border: solid windowtext 1pt #05164d;
  mso-border-alt: solid windowtext 0.5pt;
  padding: 1pt 4pt 1pt 4pt #05164d;
  font-size: 12.0pt;
  margin-left: 4.25pt;
  margin-right: 4.25pt;
}

.coverpage_warning {
  color: #fedc5b;
  font-size: 12.0pt;
}

a.TableFootnoteRef, span.TableFootnoteRef {
  mso-style-priority: 99;
  mso-style-parent: "Footnote Reference";
  vertical-align: super;
}

aside {
  font-size: 12.0pt;
}

.example-title {
  font-weight: bold;
  margin-left: -36pt;
}

p.example, li.example, td.example {
  margin-right: 0pt;
  margin-left: 0pt;
  font-size: 11.0pt;
  font-family: Arial,sans-serif;
}

div.example {
  margin-right: 36pt;
  margin-left: 36pt;
  margin-top: 0cm;
  margin-bottom: 0cm;
}

p.example, li.example, div.example, td.example {
  mso-pagination: none;
}

td.example p.MsoListParagraph {
  font-size: 11.0pt;
}

div.example p.MsoListParagraph {
  font-size: 11.0pt;
}

div.Note p.MsoListParagraph {
  font-size: 11.0pt;
}

div.Note span.stem {
  font-size: 11.0pt;
}

div.Note p.Sourcecode, div.Note pre.Sourcecode {
  font-size: 9pt;
  margin-left: 1cm;
}

div.Note table.dl {
  font-size: 11.0pt;
  margin-left: 1cm;
}

span.note_label, span.example_label, td.example_label, td.note_label {
  font-size: 11.0pt;
  font-family: Arial,sans-serif;
}

table.dl {
  margin-top: 0cm;
  margin-right: 0cm;
  margin-bottom: 11.0pt;
  margin-left: 20.15pt;
}

